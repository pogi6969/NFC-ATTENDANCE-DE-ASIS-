# Copy this file to .env and fill in what you need. Everything has a working default.

# Web server
PORT=3000
# The address people use to open the system, e.g. https://attendance.yourschool.edu.ph
# Used in the parent invite text message.
PUBLIC_URL=
# Set to 1 when running behind a hosting proxy (Render, Railway, Fly, Nginx).
TRUST_PROXY=

# Where the SQLite database is stored. Point this at a persistent disk in the cloud.
DATA_DIR=./data

# Long random string used to sign logins. Generated and saved in the database if empty.
APP_SECRET=

# School time zone and the country code used to turn 0917... into +63917...
SCHOOL_TIMEZONE=Asia/Manila
DEFAULT_COUNTRY_CODE=63

# First administrator account, created on the first start only.
# If ADMIN_PASSWORD is empty a random password is printed in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Text messages to parents ----
# console   = print messages in the server log (testing)
# semaphore = Semaphore SMS (Philippines) https://semaphore.co
# twilio    = Twilio SMS
# webhook   = POST {"to","message"} as JSON to your own SMS gateway
# none      = do not send texts
SMS_PROVIDER=console

SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---- App notifications to parents (Web Push) ----
# Keys are generated and saved in the database if empty.
# Generate your own with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
